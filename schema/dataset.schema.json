{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jakobtroidl/mia-agentic-search/schema/dataset.schema.json",
  "title": "MicroscopyTrainingDataset",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "short_name",
    "description",
    "landing_url",
    "doi",
    "repository",
    "accession",
    "authors",
    "publications",
    "date_published",
    "imaging",
    "data",
    "annotations",
    "ml",
    "license",
    "provenance",
    "verification",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "1.1",
        "1.2"
      ],
      "description": "1.2 adds the `technical` block (enricher)"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 80,
      "description": "slug; must equal file name without .yaml"
    },
    "title": {
      "type": "string",
      "minLength": 5,
      "maxLength": 300
    },
    "short_name": {
      "type": "string",
      "minLength": 5,
      "maxLength": 50,
      "description": "Short human name used as the PR title, e.g. 'CryoVesNet synaptic vesicles (cryo-ET)'."
    },
    "description": {
      "type": "string",
      "minLength": 30,
      "maxLength": 2000
    },
    "landing_url": {
      "type": "string",
      "format": "uri"
    },
    "doi": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^10\\.\\d{4,9}/\\S+$"
    },
    "repository": {
      "enum": [
        "EMPIAR",
        "IDR",
        "BioImageArchive",
        "Zenodo",
        "Figshare",
        "OpenOrganelle",
        "BossDB",
        "CIL",
        "DANDI",
        "HuggingFace",
        "Kaggle",
        "GrandChallenge",
        "CellTrackingChallenge",
        "Dryad",
        "OSF",
        "GitHub",
        "LabWebsite",
        "other"
      ]
    },
    "accession": {
      "type": [
        "string",
        "null"
      ],
      "description": "repository-native ID, e.g. EMPIAR-10311"
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "publications": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "doi",
          "url"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "doi": {
            "type": [
              "string",
              "null"
            ]
          },
          "url": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          }
        }
      }
    },
    "date_published": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "imaging": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modality",
        "dimensionality",
        "voxel_size_nm",
        "channels",
        "organism",
        "sample",
        "labels_stains"
      ],
      "properties": {
        "modality": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "FIB-SEM",
              "SBF-SEM",
              "ssTEM",
              "ssSEM",
              "TEM",
              "cryo-EM",
              "cryo-ET",
              "X-ray",
              "confocal",
              "spinning-disk",
              "widefield",
              "light-sheet",
              "two-photon",
              "super-resolution",
              "expansion",
              "brightfield",
              "histology-WSI",
              "phase-contrast",
              "DIC",
              "fluorescence-other",
              "other"
            ]
          }
        },
        "dimensionality": {
          "enum": [
            "2D",
            "3D",
            "2D+t",
            "3D+t"
          ]
        },
        "voxel_size_nm": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "x",
            "y",
            "z"
          ],
          "properties": {
            "x": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "y": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "z": {
              "type": [
                "number",
                "null"
              ],
              "exclusiveMinimum": 0
            }
          }
        },
        "channels": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "organism": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "NCBI taxonomy scientific names, e.g. 'Drosophila melanogaster'"
        },
        "sample": {
          "type": [
            "string",
            "null"
          ],
          "description": "tissue / cell type / region"
        },
        "labels_stains": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formats",
        "size_bytes",
        "n_items",
        "access",
        "download_url",
        "download_method"
      ],
      "properties": {
        "formats": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "tiff",
              "ome-tiff",
              "ome-zarr",
              "zarr",
              "n5",
              "hdf5",
              "mrc",
              "png",
              "jpeg",
              "czi",
              "nd2",
              "lif",
              "svs",
              "dicom",
              "precomputed",
              "nifti",
              "other"
            ]
          }
        },
        "size_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "n_items": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "images or volumes"
        },
        "access": {
          "enum": [
            "open",
            "registration",
            "on-request",
            "restricted"
          ]
        },
        "download_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "download_method": {
          "enum": [
            "http",
            "ftp",
            "aspera",
            "s3",
            "globus",
            "api",
            "git-lfs",
            "other"
          ]
        }
      }
    },
    "annotations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "present",
        "types",
        "coverage",
        "format",
        "source"
      ],
      "properties": {
        "present": {
          "type": "boolean"
        },
        "types": {
          "type": "array",
          "items": {
            "enum": [
              "semantic-segmentation",
              "instance-segmentation",
              "bounding-box",
              "points",
              "tracking",
              "classification",
              "skeleton",
              "synapse",
              "organelle",
              "restoration-pairs",
              "counts",
              "other"
            ]
          }
        },
        "coverage": {
          "enum": [
            "dense",
            "sparse",
            "partial",
            "unknown"
          ]
        },
        "format": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "enum": [
            "manual",
            "proofread",
            "automatic",
            "mixed",
            "unknown"
          ]
        }
      }
    },
    "ml": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tasks",
        "splits_provided",
        "benchmark",
        "baseline_code_url"
      ],
      "properties": {
        "tasks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "segmentation",
              "detection",
              "tracking",
              "classification",
              "denoising",
              "super-resolution",
              "registration",
              "reconstruction",
              "self-supervised",
              "other"
            ]
          }
        },
        "splits_provided": {
          "type": "boolean"
        },
        "benchmark": {
          "type": [
            "string",
            "null"
          ],
          "description": "challenge / leaderboard name"
        },
        "baseline_code_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        }
      }
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spdx",
        "url"
      ],
      "properties": {
        "spdx": {
          "type": "string",
          "description": "SPDX id (CC-BY-4.0, CC0-1.0, ...) or 'unknown' / 'custom'"
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "discovered_by",
        "discovered_at",
        "evidence_urls",
        "confidence"
      ],
      "properties": {
        "discovered_by": {
          "enum": [
            "harvest-repositories",
            "harvest-literature",
            "harvest-websearch",
            "maintainer",
            "human"
          ]
        },
        "discovered_at": {
          "type": "string",
          "format": "date-time"
        },
        "evidence_urls": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "format": "uri"
          }
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Estimated probability (0-1) that a reviewer who checks the cited sources would find (a) every field in this record correct and (b) the dataset genuinely usable for training as described. Bands: high >= 0.85, medium 0.65-0.85, low 0.5-0.65. Capped by verification: url_ok=false -> max 0.5; license_found=false -> max 0.7; annotations_verified=false -> max 0.85."
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url_ok",
        "license_found",
        "annotations_verified",
        "last_checked"
      ],
      "properties": {
        "url_ok": {
          "type": "boolean"
        },
        "license_found": {
          "type": "boolean"
        },
        "annotations_verified": {
          "type": "boolean"
        },
        "last_checked": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "notes": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 1000
    },
    "technical": {
      "type": "object",
      "additionalProperties": false,
      "description": "Technical inspection by the enricher routine: what the files actually contain.",
      "required": [
        "method",
        "size_source",
        "layout",
        "sample",
        "arrays",
        "notes"
      ],
      "properties": {
        "method": {
          "enum": [
            "metadata-only",
            "header",
            "sample"
          ],
          "description": "deepest inspection done: file listings/docs only, file headers (tools/probe.py), or downloaded data (tools/sample.py)"
        },
        "inspected_at": true,
        "inspected_urls": true,
        "bytes_downloaded": true,
        "size_source": {
          "enum": [
            "file-listing",
            "page-stated",
            "paper",
            "estimated",
            "unknown"
          ],
          "description": "where data.size_bytes comes from; only file-listing (every file listed with an exact size by tools/listing.py) counts as confirmed"
        },
        "layout": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tree",
            "n_files",
            "listing_complete"
          ],
          "properties": {
            "tree": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 4000,
              "description": "folder tree from tools/listing.py, ≤ 40 lines"
            },
            "n_files": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "listing_complete": {
              "type": "boolean"
            }
          }
        },
        "sample": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "urls",
            "size_bytes",
            "description"
          ],
          "description": "smallest self-contained unit (e.g. one raw+label pair) for a quick test download",
          "properties": {
            "urls": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              },
              "description": "file URLs; a zip member is written <zip url>::<path in zip>"
            },
            "size_bytes": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "description": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "arrays": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/array"
          }
        },
        "notes": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 1500
        }
      },
      "$comment": "deprecated keys (true = ignored): still on PR branches enriched earlier; nothing reads them"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "annotations": {
            "properties": {
              "present": {
                "const": false
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "ml": {
            "properties": {
              "tasks": {
                "items": {
                  "enum": [
                    "denoising",
                    "super-resolution",
                    "self-supervised",
                    "reconstruction",
                    "registration",
                    "other"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "1.2"
          }
        }
      },
      "then": {
        "required": [
          "technical"
        ]
      }
    }
  ],
  "$defs": {
    "array": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "path_pattern",
        "format",
        "axes",
        "shape",
        "dtype",
        "compression"
      ],
      "properties": {
        "role": {
          "enum": [
            "raw",
            "target",
            "label",
            "other"
          ],
          "description": "target = restoration ground truth (high-SNR / high-res)"
        },
        "path_pattern": {
          "type": "string",
          "description": "glob of the files holding this array, relative to the layout tree"
        },
        "format": {
          "enum": [
            "tiff",
            "ome-tiff",
            "ome-zarr",
            "zarr",
            "n5",
            "hdf5",
            "mrc",
            "png",
            "jpeg",
            "czi",
            "nd2",
            "lif",
            "svs",
            "dicom",
            "precomputed",
            "nifti",
            "csv",
            "json",
            "other"
          ]
        },
        "axes": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[tczyxs]+$",
          "description": "slowest to fastest; s = RGB samples; null if the file does not say"
        },
        "shape": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "description": "of a representative item, in `axes` order"
        },
        "shape_varies": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "dtype": {
          "enum": [
            "bool",
            "uint8",
            "uint16",
            "uint32",
            "uint64",
            "int8",
            "int16",
            "int32",
            "int64",
            "float16",
            "float32",
            "float64",
            "complex64",
            "unknown"
          ]
        },
        "compression": {
          "enum": [
            "none",
            "lzw",
            "deflate",
            "packbits",
            "zstd",
            "lzma",
            "lz4",
            "blosc",
            "gzip",
            "bz2",
            "jpeg",
            "jpeg2000",
            "jpegxl",
            "webp",
            "png",
            "compressed-segmentation",
            "other",
            "unknown"
          ],
          "description": "inside the files (not the zip around them)"
        },
        "lossy": true,
        "chunks": true,
        "value_range": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2,
          "description": "observed [min, max] in a downloaded sample (method: sample only)"
        },
        "normalization": {
          "enum": [
            "none",
            "rescaled",
            "standardized",
            "contrast-stretched",
            "unknown"
          ]
        },
        "encoding": {
          "enum": [
            "binary",
            "semantic-ids",
            "instance-ids",
            "one-hot",
            "rgb-colors",
            "probability",
            "polygons",
            "points-table",
            "boxes-table",
            "tracks-table",
            "graph",
            "other",
            "unknown"
          ],
          "description": "how labels are stored (role: label)"
        },
        "classes": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name"
            ],
            "properties": {
              "id": {
                "type": [
                  "integer",
                  "string",
                  "null"
                ]
              },
              "name": {
                "type": "string"
              }
            }
          }
        },
        "n_ids_observed": true,
        "alignment": {
          "enum": [
            "same-grid",
            "scaled",
            "offset",
            "cropped",
            "transform-provided",
            "not-applicable",
            "unknown"
          ],
          "description": "how this array relates to the raw data's voxel grid (label / target arrays)"
        },
        "alignment_notes": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "$comment": "deprecated keys (true = ignored): still on PR branches enriched earlier; nothing reads them"
    }
  }
}
